# ===========================================
# SBL Infrastructure - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# DOMAINS
# ===========================================
FRONTEND_DOMAIN=sbl.example.com
API_DOMAIN=api.sbl.example.com
FRONTEND_URL=https://sbl.example.com
# Interface Uptime Kuma et status page publique
MONITORING_DOMAIN=status.sbl.example.com

# ===========================================
# SSL/TLS - Let's Encrypt
# ===========================================
ACME_EMAIL=admin@example.com

# ===========================================
# DATABASE - PostgreSQL
# ===========================================
POSTGRES_USER=sbl
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sbl

# ===========================================
# API - Symfony
# ===========================================
# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME_RANDOM_HEX_STRING

# CORS - Adjust to match your frontend domain
CORS_ALLOW_ORIGIN=^https://sbl\.example\.com$

# JWT Configuration
# Generate keys with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:4096
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_PASSPHRASE=CHANGE_ME_JWT_PASSPHRASE

# ===========================================
# DISCORD - OAuth & Bot
# ===========================================
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://api.sbl.example.com/api/auth/discord/callback

# Bot token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token

# Shared secret between API and Bot for internal auth
# Generate with: openssl rand -hex 32
DISCORD_BOT_SECRET=CHANGE_ME_SHARED_SECRET

# ===========================================
# SUPERVISION - Uptime Kuma
# ===========================================
# Voir docs/SUPERVISION.md pour le détail des sondes, des seuils et de la
# politique d'escalade.

# Version déployée — exposée par GET /api/health, ce qui relie une anomalie
# constatée en production à une release précise du journal de versions.
# Renseignée par la procédure de déploiement :
#   export APP_VERSION=$(git describe --tags --abbrev=0)
#   export APP_COMMIT=$(git rev-parse HEAD)
APP_VERSION=dev
APP_COMMIT=unknown

# Sonde push du bot Discord (heartbeat).
# Le token est généré par Uptime Kuma à la création de la sonde de type « Push ».
# L'URL est interne au réseau Docker : le bot n'a pas besoin de sortir sur
# Internet pour signaler sa vitalité.
UPTIME_KUMA_PUSH_URL=http://uptime-kuma:3001/api/push/CHANGE_ME_TOKEN
UPTIME_KUMA_PUSH_INTERVAL=60

# Webhook Discord de collecte des erreurs applicatives (canal #alertes-technique).
# Laisser vide pour désactiver : le handler Monolog reste alors inerte.
ALERT_DISCORD_WEBHOOK=

# Sentry — collecte des anomalies non gérées (stack trace + contexte requête).
# Le bundle n'est chargé qu'en production ; un DSN vide rend le SDK inerte.
SENTRY_DSN=
